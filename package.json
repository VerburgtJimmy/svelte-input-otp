{
	"name": "@jimmyverburgt/svelte-input-otp",
	"version": "0.5.2",
	"author": "Jimmy Verburgt <hey@jimmyverburgt.com>",
	"description": "One time passcode Input for svelte. Accessible & unstyled.",
	"homepage": "svelte-input-otp.jimmyverburgt.com",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/VerburgtJimmy/svelte-input-otp.git"
	},
	"bugs": {
		"url": "https://github.com/VerburgtJimmy/svelte-input-otp/issues"
	},
	"keywords": [
		"svelte",
		"input",
		"otp",
		"accessible",
		"input-otp",
		"input component",
		"svelte-input-otp",
		"svelte component"
	],
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run package",
		"buildweb": "vite build",
		"preview": "vite preview",
		"package": "svelte-kit sync && svelte-package && publint",
		"prepublishOnly": "npm run package",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"peerDependencies": {
		"svelte": "^5"
	},
	"devDependencies": {
		"@internationalized/date": "^3.10.0",
		"@lucide/svelte": "^0.561.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.49.2",
		"@sveltejs/package": "^2.5.7",
		"@tailwindcss/vite": "^4.1.18",
		"@types/eslint": "^9.6.1",
		"autoprefixer": "^10.4.22",
		"bits-ui": "^2.14.4",
		"clsx": "^2.1.1",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.13.1",
		"globals": "^16.5.0",
		"lucide-svelte": "^0.561.0",
		"mode-watcher": "^1.1.0",
		"postcss": "^8.5.6",
		"prettier": "^3.7.4",
		"prettier-plugin-svelte": "^3.4.0",
		"publint": "^0.3.16",
		"rehype-pretty-code": "^0.14.1",
		"rehype-stringify": "^10.0.0",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"shiki": "^3.20.0",
		"svelte": "^5",
		"svelte-check": "^4.3.4",
		"svelte-confetti": "^2.3.2",
		"tailwind-merge": "^3.4.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.1.18",
		"tslib": "^2.4.1",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.49.0",
		"unified": "^11.0.5"
	},
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module"
}
